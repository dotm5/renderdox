<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Keep an ordinary Release build aligned with the shipped Windows runtime.
    Command-line properties can still override any of these defaults for
    diagnostics or an all-generations child-propagation build.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DCompHookIntoChildrenDefault
        Condition="'$(DCompHookIntoChildrenDefault)'==''">1</DCompHookIntoChildrenDefault>
    <DCompStaticRuntime Condition="'$(DCompStaticRuntime)'==''">1</DCompStaticRuntime>
    <DCompInlineGraphicsHooks
        Condition="'$(DCompInlineGraphicsHooks)'==''">1</DCompInlineGraphicsHooks>
    <DCompSingleGenerationChildHook
        Condition="'$(DCompSingleGenerationChildHook)'==''">1</DCompSingleGenerationChildHook>
  </PropertyGroup>

  <!--
    Fast Release is the default for local builds. Set RDocEnableLTCG=true for
    the original whole-program-optimised release profile.

    This file is imported after project-local settings, so it also covers the
    static driver libraries that feed the Core DLL. Disabling WPO only in
    renderdoc.vcxproj is insufficient because /GL objects from those libraries
    still force link-time code generation.
  -->
  <PropertyGroup>
    <RDocEnableLTCG Condition="'$(RDocEnableLTCG)'==''">false</RDocEnableLTCG>
    <RDocClangMsvcFallback Condition="'$(RDocClangMsvcFallback)'==''">true</RDocClangMsvcFallback>
    <!--
      Raw DLL injection does not receive capture options from the GUI. Release
      builds propagate capture into child processes by default; non-Release
      builds keep the upstream default unless explicitly overridden.
    -->
    <DCompHookIntoChildrenDefault Condition="'$(DCompHookIntoChildrenDefault)'==''">0</DCompHookIntoChildrenDefault>
    <!--
      Release Core builds and every static library in their link graph use /MT
      so injection cannot bind to an application-local MSVC runtime.
    -->
    <DCompStaticRuntime Condition="'$(DCompStaticRuntime)'==''">0</DCompStaticRuntime>
    <!--
      Some applications resolve graphics entry points from export tables and never
      expose an import or GetProcAddress call that the normal hook path can patch.
      Release builds enable entry detours for registered DXGI/D3D hooks.
    -->
    <DCompInlineGraphicsHooks Condition="'$(DCompInlineGraphicsHooks)'==''">0</DCompInlineGraphicsHooks>
    <!--
      A manually injected launcher still needs to inject the real game, but the
      game should not propagate the Core into login/helper descendants by
      default. Release builds clear hookIntoChildren in the injected child.
    -->
    <DCompSingleGenerationChildHook Condition="'$(DCompSingleGenerationChildHook)'==''">0</DCompSingleGenerationChildHook>
    <!--
      Opt-in runtime isolation switches for controlled A/B diagnostics. All
      defaults preserve normal behaviour; diagnostic packages set one variable
      at a time and identify themselves with a numeric variant ID in the log.
    -->
    <DCompDiagnosticVariantId Condition="'$(DCompDiagnosticVariantId)'==''">0</DCompDiagnosticVariantId>
    <DCompDisableAllHooks Condition="'$(DCompDisableAllHooks)'==''">0</DCompDisableAllHooks>
    <DCompDisableWin32SystemHooks Condition="'$(DCompDisableWin32SystemHooks)'==''">0</DCompDisableWin32SystemHooks>
    <DCompDisableTargetControl Condition="'$(DCompDisableTargetControl)'==''">0</DCompDisableTargetControl>
    <DCompDisableOverlay Condition="'$(DCompDisableOverlay)'==''">0</DCompDisableOverlay>
    <DCompPassthroughNonInjectedChildren Condition="'$(DCompPassthroughNonInjectedChildren)'==''">0</DCompPassthroughNonInjectedChildren>
    <DCompPassthroughAllNonInjectedChildren Condition="'$(DCompPassthroughAllNonInjectedChildren)'==''">0</DCompPassthroughAllNonInjectedChildren>
    <DCompDisableWSAHooks Condition="'$(DCompDisableWSAHooks)'==''">0</DCompDisableWSAHooks>
    <DCompDiagnosticTargetInitStage Condition="'$(DCompDiagnosticTargetInitStage)'==''">0</DCompDiagnosticTargetInitStage>
  </PropertyGroup>

  <!--
    Keep capture and diagnostic feature macros identical for the Core PCH and
    every translation unit. The macros are consumed only in implementation
    files, but Clang correctly warns if a /Yu compile changes command-line
    definitions after the PCH was created.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='renderdoc'">
    <ClCompile>
      <PreprocessorDefinitions>DCOMP_DEFAULT_HOOK_INTO_CHILDREN=$(DCompHookIntoChildrenDefault);DCOMP_INLINE_GRAPHICS_HOOKS=$(DCompInlineGraphicsHooks);DCOMP_SINGLE_GENERATION_CHILD_HOOK=$(DCompSingleGenerationChildHook);DCOMP_DIAGNOSTIC_VARIANT_ID=$(DCompDiagnosticVariantId);DCOMP_DIAGNOSTIC_TARGET_INIT_STAGE=$(DCompDiagnosticTargetInitStage);DCOMP_DIAGNOSTIC_DISABLE_ALL_HOOKS=$(DCompDisableAllHooks);DCOMP_DIAGNOSTIC_DISABLE_WIN32_SYSTEM_HOOKS=$(DCompDisableWin32SystemHooks);DCOMP_DIAGNOSTIC_DISABLE_TARGET_CONTROL=$(DCompDisableTargetControl);DCOMP_DIAGNOSTIC_DISABLE_OVERLAY=$(DCompDisableOverlay);DCOMP_DIAGNOSTIC_PASSTHROUGH_NONINJECTED_CHILDREN=$(DCompPassthroughNonInjectedChildren);DCOMP_DIAGNOSTIC_PASSTHROUGH_ALL_NONINJECTED_CHILDREN=$(DCompPassthroughAllNonInjectedChildren);DCOMP_DIAGNOSTIC_DISABLE_WSA_HOOKS=$(DCompDisableWSAHooks);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    version.obj contains only the Git hash constant and is linked into both the
    /MT capture DLL and the /MD Qt GUI. It has no CRT calls, so omit its default
    runtime directive and let each final binary select its own CRT contract.
  -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)'=='renderdoc_version'">
    <ClCompile>
      <OmitDefaultLibName>true</OmitDefaultLibName>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Keep the override scoped to the injected Core's complete link graph. This
    avoids changing the CRT contract of qrenderdoc/Qt or unrelated utilities
    when the full solution is built with DCompStaticRuntime enabled.
  -->
  <PropertyGroup>
    <DCompCoreRuntimeProject
        Condition="'$(MSBuildProjectName)'=='renderdoc' Or
                   '$(MSBuildProjectName)'=='renderdoc_version' Or
                   '$(MSBuildProjectName)'=='renderdoc_d3d11' Or
                   '$(MSBuildProjectName)'=='renderdoc_d3d12' Or
                   '$(MSBuildProjectName)'=='renderdoc_dxgi' Or
                   '$(MSBuildProjectName)'=='renderdoc_gl' Or
                   '$(MSBuildProjectName)'=='renderdoc_vulkan' Or
                   '$(MSBuildProjectName)'=='renderdoc_dxbc' Or
                   '$(MSBuildProjectName)'=='renderdoc_dxil' Or
                   '$(MSBuildProjectName)'=='renderdoc_spirv' Or
                   '$(MSBuildProjectName)'=='AMD' Or
                   '$(MSBuildProjectName)'=='ARM' Or
                   '$(MSBuildProjectName)'=='Intel' Or
                   '$(MSBuildProjectName)'=='NV' Or
                   '$(MSBuildProjectName)'=='breakpad_common' Or
                   '$(MSBuildProjectName)'=='crash_generation_client' Or
                   '$(MSBuildProjectName)'=='crash_generation_server' Or
                   '$(MSBuildProjectName)'=='exception_handler'">true</DCompCoreRuntimeProject>
  </PropertyGroup>

  <ItemDefinitionGroup
      Condition="('$(DCompStaticRuntime)'=='1' Or '$(DCompStaticRuntime)'=='true') And
                 '$(DCompCoreRuntimeProject)'=='true'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    The projects intentionally use /WX for MSVC. ClangCL diagnoses additional
    Microsoft extensions that are accepted by the supported MSVC build, so keep
    those diagnostics visible without making them build-stopping errors.

    This must live in Directory.Build.targets rather than Directory.Build.props:
    project-local ItemDefinitionGroups are evaluated after .props and otherwise
    restore /WX. The explicit narrowing override is needed because Clang treats
    that diagnostic as an error by default, independently of /WX.
  -->
  <PropertyGroup
      Condition="'$(PlatformToolset)'=='ClangCL' And
                 '$(RDocClangMsvcFallback)'=='true' And
                 ('$(MSBuildProjectName)'=='renderdoc_d3d11' Or
                  '$(MSBuildProjectName)'=='renderdoc_d3d12' Or
                  '$(MSBuildProjectName)'=='renderdoc_vulkan' Or
                  '$(MSBuildProjectName)'=='renderdoccmd' Or
                  '$(MSBuildProjectName)'=='NV')">
    <!--
      D3D12 and NV include three empty-argument variadic macro calls that depend
      on the legacy MSVC preprocessor's comma elision. D3D11 relies on MSVC's
      template-instantiation timing. Vulkan contains a template parameter whose
      top-level const qualification produces a different specialisation symbol
      under Clang. renderdoccmd includes a UTF-16 resource header that Clang's
      source reader does not support. Clang has no compatibility switch that
      accepts these constructs as written. Keep the source untouched and compile
      only these ABI-compatible objects with the installed MSVC frontend;
      llvm-lib/lld-link and every other project remain on ClangCL.
    -->
    <RDocUseMsvcFrontend>true</RDocUseMsvcFrontend>
    <RDocMsvcTargetArchitecture Condition="'$(Platform)'=='Win32'">x86</RDocMsvcTargetArchitecture>
    <RDocMsvcTargetArchitecture Condition="'$(Platform)'=='x64'">x64</RDocMsvcTargetArchitecture>
    <CLToolExe>cl.exe</CLToolExe>
    <CLToolPath>$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\$(RDocMsvcTargetArchitecture)</CLToolPath>
    <IncludePath>$(SolutionDir)util\sdkfix;$(VC_IncludePath);$(WindowsSDK_IncludePath)</IncludePath>
    <LlvmArchitectureSwitch></LlvmArchitectureSwitch>
  </PropertyGroup>

  <ItemGroup
      Condition="'$(PlatformToolset)'=='ClangCL' And '$(RDocUseMsvcFrontend)'!='true'">
    <ClCompile Update="@(ClCompile)">
      <TreatWarningAsError>false</TreatWarningAsError>
      <AdditionalOptions>%(AdditionalOptions) -Wno-error=c++11-narrowing</AdditionalOptions>
    </ClCompile>
  </ItemGroup>

  <ItemGroup Condition="'$(RDocUseMsvcFrontend)'=='true'">
    <ClCompile Update="@(ClCompile)">
      <TreatWarningAsError>false</TreatWarningAsError>
      <AdditionalOptions>%(AdditionalOptions) /wd4100</AdditionalOptions>
    </ClCompile>
  </ItemGroup>

  <ItemGroup
      Condition="'$(PlatformToolset)'=='ClangCL' And '$(MSBuildProjectName)'=='renderdoc'">
    <!--
      MSVC finds the PCH header relative to core\precompiled.cpp. Clang requires
      the same header to be reachable by the spelling used in /Yc and /Yu.
    -->
    <ClCompile Update="@(ClCompile)">
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemGroup>

  <ItemGroup
      Condition="'$(PlatformToolset)'=='ClangCL' And '$(MSBuildProjectName)'=='qrenderdoc_local'">
    <!--
      Make the PCH header reachable by the exact spelling used by /Yc and /Yu.
      Scintilla also treats clang-cl as old MSVC and includes stddef.h instead
      of stdint.h, so force that header only into its non-PCH source.
    -->
    <ClCompile Update="@(ClCompile)">
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\Code;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ClCompile Update="3rdparty\scintilla\qt\ScintillaEditBase\ScintillaEditBase.cpp">
      <ForcedIncludeFiles>stdint.h</ForcedIncludeFiles>
    </ClCompile>
  </ItemGroup>

  <ItemGroup
      Condition="'$(PlatformToolset)'=='ClangCL' And '$(MSBuildProjectName)'=='renderdocshim'">
    <!--
      The shim intentionally has no CRT. Prevent Release loop recognition from
      replacing its explicit byte clear with an unresolved memset library call.
    -->
    <ClCompile Update="@(ClCompile)">
      <AdditionalOptions>%(AdditionalOptions) -fno-builtin-memset</AdditionalOptions>
    </ClCompile>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' And '$(RDocEnableLTCG)'!='true'">
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release' And '$(RDocEnableLTCG)'!='true'">
    <ClCompile>
      <WholeProgramOptimization>false</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>Default</LinkTimeCodeGeneration>
    </Link>
    <Lib>
      <LinkTimeCodeGeneration>false</LinkTimeCodeGeneration>
    </Lib>
  </ItemDefinitionGroup>
</Project>
