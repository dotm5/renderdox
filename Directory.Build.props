<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Reproducible diagnostics shared by all Windows projects. -->
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>

  <!-- ClangCL 产物隔离到独立目录，避免覆盖 MSVC 构建 -->
  <PropertyGroup>
    <RepoRoot Condition="'$(RepoRoot)'==''">$(MSBuildThisFileDirectory)</RepoRoot>
    <OutDir Condition="'$(PlatformToolset)'=='ClangCL'">$(RepoRoot)$(Platform)\Clang$(Configuration)\</OutDir>
    <IntDir Condition="'$(PlatformToolset)'=='ClangCL'">$(RepoRoot)$(Platform)\Clang$(Configuration)\obj\</IntDir>
  </PropertyGroup>

  <PropertyGroup>
    <RDocConfigurationName
        Condition="'$(PlatformToolset)'=='ClangCL'">Clang$(Configuration)</RDocConfigurationName>
    <RDocConfigurationName
        Condition="'$(RDocConfigurationName)'==''">$(Configuration)</RDocConfigurationName>
    <RDocOutputRoot>$(RepoRoot)$(Platform)\$(RDocConfigurationName)\</RDocOutputRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/Brepro /utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile
        Condition="'$(PlatformToolset)'=='ClangCL' And
                   '$(MSBuildProjectName)'!='renderdoc_d3d11' And
                   '$(MSBuildProjectName)'!='renderdoc_d3d12' And
                   '$(MSBuildProjectName)'!='renderdoc_vulkan' And
                   '$(MSBuildProjectName)'!='renderdoccmd' And
                   '$(MSBuildProjectName)'!='NV'">
      <AdditionalOptions>/Brepro /utf-8 -Wno-sign-compare -Wno-unused-parameter -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-value -Wno-unused-private-field -Wno-missing-field-initializers -Wno-reorder-ctor -Wno-microsoft-goto -Wno-deprecated-literal-operator -Wno-overloaded-virtual -Wno-microsoft-template -Wno-microsoft-exception-spec -Wno-unknown-pragmas -Wno-null-dereference -Wno-inconsistent-missing-override -Wno-unused-local-typedef -Wno-missing-braces -Wno-format -Wno-char-subscripts -Wno-invalid-offsetof -Wno-deprecated-copy -Wno-cast-function-type-mismatch -Wno-return-type -Wno-nonportable-include-path -Wno-microsoft-cast %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/PDBALTPATH:%_PDB% /Brepro %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
