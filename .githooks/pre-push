#!/bin/sh
set -eu
repository_root=$(git rev-parse --show-toplevel)
if command -v python3 >/dev/null 2>&1; then
    policy_python=python3
else
    policy_python=python
fi
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        *[!0]*) ;;
        *) continue ;;
    esac
    "$policy_python" "$repository_root/util/buildscripts/check_public_content.py" \
        --repo "$repository_root" --revision "$local_oid" --base "$remote_oid"
done
